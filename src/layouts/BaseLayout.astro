---
import '../styles/global.css';

export interface Props {
  extraClasses?: string;
}
const { extraClasses = '' } = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Emily Hong’s personal website and portfolio."
    />
    <link rel="icon" type="image/ico+xml" href="/favicon.ico" />
    <link rel="stylesheet" href="../styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>elyhng online</title>
  </head>
  <body class={`font-sans text-dark-gray w-full min-h-screen m-0 ${extraClasses}`}>
    <slot />
  </body>
</html>
