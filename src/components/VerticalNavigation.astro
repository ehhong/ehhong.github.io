---
const verticalNavLinkStyle =
  'underline underline-offset-1 decoration-beige hover:decoration-dark-gray';
const topNavLinkStyle = 'mx-0.5';
---

<!-- Vertical nav (desktop only) -->
<nav
  class="hidden md:flex fixed z-20 left-0 top-[10vh] h-[80vh] w-[3vw] md:w-[1.5vw] bg-beige items-center justify-between px-0"
>
  <!-- Dark gray scroll overlay -->
  <div
    class="fixed z-30 left-0 w-[3vw] md:w-[1.5vw] h-[3vh] bg-dark-gray scroll-overlay"
  >
  </div>

  <div class="h-full flex flex-col items-center justify-between">
    <a class="flex flex-col font-bold text-dark-gray ml-3" href="/">
      <h1 class="text-3xl -mb-3">ely</h1>
      <h1 class="text-3xl -mb-5">hng</h1>
    </a>
    <div
      class="h-full flex flex-col ml-[3.5vw] md:ml-[2vw] text-sm text-dark-gray justify-end"
    >
      <a class={verticalNavLinkStyle} href="/about">about</a>
      <a class={verticalNavLinkStyle} href="/illustration">illustration</a>
      <a
        class:list={[verticalNavLinkStyle, 'whitespace-nowrap']}
        href="https://elyhng.notion.site/things-i-like-2220aa57d3c2807680dbc0fab330cb87"
        >things i like</a
      >
    </div>
  </div>
</nav>

<!-- Mobile only top nav -->
<div class="md:hidden flex flex-col w-full items-center my-8">
  <a class="flex flex-col mb-10" href="/">
    <h1 class="text-3xl font-semibold -mb-3">ely</h1>
    <h1 class="text-3xl font-semibold -mb-5">hng</h1>
  </daiv>
  <nav class="flex justify-around w-[90vw]">
    <a class={topNavLinkStyle} href="/about">about</a>
    <hr class="w-full mt-3">
    <a class={topNavLinkStyle} href="/illustration">illustration</a>
    <hr class="w-full mt-3">
    <a
      class:list={[topNavLinkStyle, 'whitespace-nowrap']}
      href="https://elyhng.notion.site/things-i-like-2220aa57d3c2807680dbc0fab330cb87"
      >things i like</a
    >
  </nav>
</div>

<style>
  .scroll-overlay {
    top: 10vh;
    animation: scroll-move linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 100%;
  }

  @keyframes scroll-move {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(80vh - 3vh));
    }
  }
</style>
